{
  "expo": {
    "name": "Smak Carl Berner",
    "slug": "carl-berner-delikatesse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carlbernerdelikatesse",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4EE",
    "primaryColor": "#5A1B6F",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matbutikkapp.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.matbutikkapp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5A1B6F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE",
          "dark": {
            "backgroundColor": "#F7F4EE"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "490183d9-110a-457a-8f93-2fc397dcb5ac"
      }
    },
    "owner": "abdu2003"
  }
}
